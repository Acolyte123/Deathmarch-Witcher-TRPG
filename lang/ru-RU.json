  "WITCHER.Setup.SocketHook.Chat.GiftGaveQty": "<div class=\"wdm-gift-card\"><i class=\"fa-solid fa-gift\"></i> <strong>{sender}</strong> подарил(а) <strong>{item}{qty}</strong> персонажу <strong>{target}</strong>.</div>",
  "WITCHER.Setup.SocketHook.Chat.ShieldAbsorbs": "<div class=\"wdm-attack-rider\"><i class=\"fa-solid fa-shield-halved\"></i> <strong>{label}</strong> — активный щит {target} поглощает эффект {status}.</div>",
  "WITCHER.Setup.SocketHook.Chat.TookCoin": "<div class=\"wdm-gift-card\"><i class=\"fa-solid fa-coins\"></i> <strong>{sender}</strong> забрал(а) <strong>{move} {coin}{plural}</strong> у <strong>{source}</strong>.</div>",
  "WITCHER.Setup.SocketHook.Chat.TookEverything": "<div class=\"wdm-gift-card\"><i class=\"fa-solid fa-hand-holding-dollar\"></i> <strong>{sender}</strong> забрал(а) всё у <strong>{source}</strong>.</div>",
  "WITCHER.Setup.SocketHook.Dialog.Button.BodyBlock": "Заслон телом",
